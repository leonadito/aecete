# Copie este arquivo para .env e preencha os valores antes de rodar em produção.

DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=aiciti.com.br,www.aiciti.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://aiciti.com.br,https://www.aiciti.com.br

# E-mail (notificação do formulário de contato)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.exemplo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=contato@aiciti.com.br
CONTACT_RECIPIENTS=diretoria@aiciti.com.br
